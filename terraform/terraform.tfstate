            "values": [
              "\"additionalPrometheusRulesMap\":\n  \"crashloopbackoff\":\n    \"groups\":\n    - \"name\": \"sre-kubernetes-crash-errors\"\n      \"rules\":\n      - \"alert\": \"KubernetesCrashLoopBackOff\"\n        \"annotations\":\n          \"description\": \"A container in sre-practice is repeatedly crashing.\"\n          \"summary\": \"Kubernetes CrashLoopBackOff\"\n        \"expr\": |\n          kube_pod_container_status_waiting_reason{\n            namespace=\"sre-practice\",\n            reason=\"CrashLoopBackOff\"\n          } \u003e 0\n        \"for\": \"30s\"\n        \"labels\":\n          \"severity\": \"critical\"\n          \"team\": \"sre-aiops\"\n  \"highcpu\":\n    \"groups\":\n    - \"name\": \"sre-resource-alerts\"\n      \"rules\":\n      - \"alert\": \"KubernetesHighCPU\"\n        \"annotations\":\n          \"description\": \"A pod is consuming more than approximately 0.4 CPU cores.\"\n          \"summary\": \"High Kubernetes CPU\"\n        \"expr\": |\n          sum by (pod) (\n            rate(\n              container_cpu_usage_seconds_total{\n                namespace=\"sre-practice\",\n                container!=\"\",\n                container!=\"POD\"\n              }[5m]\n            )\n          ) \u003e 0.4\n        \"for\": \"2m\"\n        \"labels\":\n          \"severity\": \"warning\"\n          \"team\": \"sre-aiops\"\n  \"imagepullbackoff\":\n    \"groups\":\n    - \"name\": \"sre-kubernetes-image-errors\"\n      \"rules\":\n      - \"alert\": \"KubernetesImagePullBackOff\"\n        \"annotations\":\n          \"description\": \"A container in sre-practice cannot pull its configured image.\"\n          \"summary\": \"Kubernetes image pull failure\"\n        \"expr\": |\n          kube_pod_container_status_waiting_reason{\n            namespace=\"sre-practice\",\n            reason=~\"ImagePullBackOff|ErrImagePull\"\n          } \u003e 0\n        \"for\": \"30s\"\n        \"labels\":\n          \"severity\": \"critical\"\n          \"team\": \"sre-aiops\"\n  \"slo\":\n    \"groups\":\n    - \"name\": \"sre-availability-alerts\"\n      \"rules\":\n      - \"alert\": \"DeploymentAvailabilitySLOBreach\"\n        \"annotations\":\n          \"description\": \"Available replicas are below the practice availability objective.\"\n          \"summary\": \"Deployment availability below 99 percent\"\n        \"expr\": |\n          (\n            kube_deployment_status_replicas_available{\n              namespace=\"sre-practice\",\n              deployment=\"sre-demo\"\n            }\n            /\n            kube_deployment_spec_replicas{\n              namespace=\"sre-practice\",\n              deployment=\"sre-demo\"\n            }\n          ) \u003c 0.99\n        \"for\": \"2m\"\n        \"labels\":\n          \"severity\": \"critical\"\n          \"team\": \"sre-aiops\"\n\"alertmanager\":\n  \"config\":\n    \"global\":\n      \"resolve_timeout\": \"5m\"\n    \"receivers\":\n    - \"name\": \"null\"\n    - \"name\": \"aiops-webhook\"\n      \"webhook_configs\":\n      - \"send_resolved\": true\n        \"url\": \"http://incident-analyzer.sre-practice.svc.cluster.local:8000/alert\"\n    \"route\":\n      \"group_by\":\n      - \"alertname\"\n      - \"namespace\"\n      \"group_interval\": \"30s\"\n      \"group_wait\": \"10s\"\n      \"receiver\": \"null\"\n      \"repeat_interval\": \"30m\"\n      \"routes\":\n      - \"matchers\":\n        - \"team=\\\"sre-aiops\\\"\"\n        \"receiver\": \"aiops-webhook\"\n  \"enabled\": true\n\"grafana\":\n  \"enabled\": true\n\"prometheus\":\n  \"enabled\": true\n"
            ],
            "verify": false,
            "version": "90.0.0",
            "wait": true,
            "wait_for_jobs": false
